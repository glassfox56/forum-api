{
  "name": "forum-api",
  "version": "1.0.0",
  "description": "",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "start": "node src/app.js",
    "start:dev": "nodemon src/app.js",
    "test": "DOTENV_CONFIG_PATH=.test.env NODE_ENV=test vitest --run",
    "test:unit": "DOTENV_CONFIG_PATH=.test.env NODE_ENV=test vitest --run src/Domains src/Applications src/Commons",
    "test:integration": "DOTENV_CONFIG_PATH=.test.env NODE_ENV=test vitest --run src/Infrastructures",
    "test:watch": "DOTENV_CONFIG_PATH=.test.env NODE_ENV=test vitest --watch",
    "test:coverage": "DOTENV_CONFIG_PATH=.test.env NODE_ENV=test vitest --coverage",
    "migrate": "node-pg-migrate",
    "migrate:test": "node-pg-migrate --envPath .test.env",
    "lint": "eslint ./",
    "test:postmanV1": "NODE_ENV=test DOTENV_CONFIG_PATH=.test.env bash scripts/test-postman.sh V1",
    "test:postmanV2": "NODE_ENV=test DOTENV_CONFIG_PATH=.test.env bash scripts/test-postman.sh V2"
  },
  "keywords": [
    "forum",
    "api",
    "dicoding"
  ],
  "author": "glassfox",
  "license": "ISC",
  "dependencies": {
    "bcrypt": "^5.1.1",
    "dotenv": "^16.6.1",
    "express": "^5.0.1",
    "instances-container": "^2.0.6",
    "jsonwebtoken": "^9.0.2",
    "nanoid": "^5.0.9",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.38.0",
    "@vitest/coverage-v8": "^4.0.17",
    "@vitest/eslint-plugin": "^1.3.26",
    "eslint": "^9.38.0",
    "eslint-config-dicodingacademy": "^0.9.5",
    "newman": "^6.2.2",
    "node-pg-migrate": "^8.0.4",
    "nodemon": "^3.1.9",
    "supertest": "^7.1.4",
    "vitest": "^4.0.17"
  }
}
